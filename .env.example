# Server Port
PORT=3000

# MongoDB Database URL
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net

# Frontend URL / API Base
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE=http://localhost:3000

# JWT Configuration
ACCESS_TOKEN_SECRET=your_access_token_secret_key_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary Credentials (Used for avatar & food image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Nodemailer Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_google_app_password

# SMS Gateway Configuration (Choose Option A or Option B)
# Option A: Fast2SMS (Recommended for Indian numbers, easy setup)
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option B: Twilio (Global SMS delivery)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
