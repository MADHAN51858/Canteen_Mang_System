    "@mui/x-data-grid": "^8.17.0",
    "apexcharts": "^5.3.6",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.1",
    "canvas": "^3.2.0",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jimp": "^1.6.0",
    "jsbarcode": "^3.12.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
